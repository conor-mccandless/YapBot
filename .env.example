# Discord application credentials. Never commit real values.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Comma-separated Discord guild snowflakes approved for the private beta.
ALLOWED_GUILD_IDS=

# Optional owner-funded OpenAI generation. Leave the key blank to use only the
# built-in static response pool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional higher-quality model for requests containing images. Blank uses OPENAI_MODEL.
OPENAI_IMAGE_MODEL=
OPENAI_REASONING_EFFORT=medium
OPENAI_DAILY_GUILD_LIMIT=100
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_MS=10000

# Matches the local PostgreSQL service in infra/compose/compose.dev.yml.
DATABASE_URL=postgresql://yapbot:yapbot_dev@localhost:5432/yapbot

LOG_LEVEL=info
NODE_ENV=development
